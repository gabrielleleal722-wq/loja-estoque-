        "\"\"\"\n",
        "Classes principais do domínio: Produto (abstrata) e ProdutoEletronico.\n",
        "\"\"\"\n",
        "\n",
        "from abc import ABC, abstractmethod\n",
        "\n",
        "\n",
        "class Produto(ABC):\n",
        "    \"\"\"Classe abstrata que representa um produto genérico do estoque.\"\"\"\n",
        "\n",
        "    def __init__(self, nome, preco, quantidade):\n",
        "        # atributos \"privados\" (encapsulamento)\n",
        "        self.__nome = nome\n",
        "        self.__preco = float(preco)\n",
        "        self.__quantidade = int(quantidade)\n",
        "\n",
        "    def get_nome(self):\n",
        "        return self.__nome\n",
        "\n",
        "    def get_preco(self):\n",
        "        return self.__preco\n",
        "\n",
        "    def get_quantidade(self):\n",
        "        return self.__quantidade\n",
        "\n",
        "    def set_preco(self, novo_preco):\n",
        "        self.__preco = float(novo_preco)\n",
        "\n",
        "    def adicionar_estoque(self, quantidade):\n",
        "        self.__quantidade += quantidade\n",
        "\n",
        "    def remover_estoque(self, quantidade):\n",
        "        if quantidade > self.__quantidade:\n",
        "            print(f\"Estoque insuficiente! Faltam {abs(self.__quantidade - quantidade)} unidade(s).\")\n",
        "        else:\n",
        "            self.__quantidade -= quantidade\n",
        "\n",
        "    def valor_total(self):\n",
        "        return self.__preco * self.__quantidade\n",
        "\n",
        "    @abstractmethod\n",
        "    def aplicar_desconto(self, percentual):\n",
        "        \"\"\"Cada subclasse deve implementar sua própria regra de desconto.\"\"\"\n",
        "        pass\n",
        "\n",
        "    def __str__(self):\n",
        "        return f\"{self.__nome} | R${self.__preco:.2f} | Qtd: {self.__quantidade}\"\n",
        "\n",
        "\n",
        "class ProdutoEletronico(Produto):\n",
        "    \"\"\"Produto eletrônico: herda de Produto e adiciona garantia.\"\"\"\n",
        "\n",
        "    def __init__(self, nome, preco, quantidade, garantia_meses):\n",
        "        super().__init__(nome, preco, quantidade)\n",
        "        self.garantia_meses = garantia_meses\n",
        "\n",
        "    def aplicar_desconto(self, percentual):\n",
        "        novo_preco = self.get_preco() - (self.get_preco() * percentual / 100)\n",
        "        self.set_preco(novo_preco)\n",
        "        print(f\"Novo preço de {self.get_nome()}: R${novo_preco:.2f}\")\n",
        "\n",
        "    def __str__(self):\n",
        "        return f\"{super().__str__()} | Garantia: {self.garantia_meses} meses\""
      ]
    }
