        "while opcao != 0:\n",
        "    print(\"\\n--- MENU ---\")\n",
        "    print(\"1 - Cadastrar produto\")\n",
        "    print(\"2 - Listar produtos\")\n",
        "    print(\"3 - Adicionar estoque\")\n",
        "    print(\"4 - Remover estoque\")\n",
        "    print(\"5 - Remover produto\")\n",
        "    print(\"6 - Buscar produto\")\n",
        "    print(\"7 - Aplicar desconto\")\n",
        "    print(\"8 - Valor total do estoque\")\n",
        "    print(\"0 - Sair\")\n",
        "\n",
        "    opcao = int(input(\"Escolha uma opção: \"))\n",
        "\n",
        "    if opcao == 1:\n",
        "        nome = input(\"Nome: \")\n",
        "        preco = float(input(\"Preço: \"))\n",
        "        quantidade = int(input(\"Quantidade: \"))\n",
        "        garantia = int(input(\"Garantia (meses): \"))\n",
        "        estoque.append(ProdutoEletronico(nome, preco, quantidade, garantia))\n",
        "        print(\"Produto cadastrado!\")\n",
        "\n",
        "    elif opcao == 2:\n",
        "        listar_produtos()\n",
        "\n",
        "    elif opcao == 3:\n",
        "        listar_produtos()\n",
        "        indice = int(input(\"Índice do produto: \"))\n",
        "        if indice >= 0 and indice < len(estoque):\n",
        "            qtd = int(input(\"Quantidade a adicionar: \"))\n",
        "            estoque[indice].adicionar_estoque(qtd)\n",
        "\n",
        "    elif opcao == 4:\n",
        "        listar_produtos()\n",
        "        indice = int(input(\"Índice do produto: \"))\n",
        "        if indice >= 0 and indice < len(estoque):\n",
        "            qtd = int(input(\"Quantidade a remover: \"))\n",
        "            estoque[indice].remover_estoque(qtd)\n",
        "\n",
        "    elif opcao == 5:\n",
        "        listar_produtos()\n",
        "        indice = int(input(\"Índice do produto a remover: \"))\n",
        "        if indice >= 0 and indice < len(estoque):\n",
        "            removido = estoque.pop(indice)\n",
        "            print(f\"'{removido.get_nome()}' removido do estoque.\")\n",
        "\n",
        "    elif opcao == 6:\n",
        "        nome = input(\"Nome do produto: \")\n",
        "        produto = buscar_produto(nome)\n",
        "        if produto is not None:\n",
        "            print(f\"Encontrado: {produto}\")\n",
        "        else:\n",
        "            print(\"Produto não encontrado.\")\n",
        "\n",
        "    elif opcao == 7:\n",
        "        listar_produtos()\n",
        "        indice = int(input(\"Índice do produto: \"))\n",
        "        if indice >= 0 and indice < len(estoque):\n",
        "            percentual = float(input(\"Percentual de desconto: \"))\n",
        "            estoque[indice].aplicar_desconto(percentual)\n",
        "\n",
        "    elif opcao == 8:\n",
        "        total = 0\n",
        "        for produto in estoque:\n",
        "            total += produto.valor_total()\n",
        "        print(f\"Valor total do estoque: R${total:.2f}\")\n",
        "\n",
        "    elif opcao == 0:\n",
        "        print(\"Encerrando o sistema...\")\n",
        "\n",
        "    else:\n",
        "        print(\"Opção inválida!\")"
